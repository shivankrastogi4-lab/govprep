@app.route('/exam/<exam_name>')
def exam_page(exam_name):
    exams = load_json('exams.json')

    # 🔥 FIX: dict handle karo
    if isinstance(exams, dict):
        exam_data = exams.get(exam_name)
    else:
        exam_data = None
        for exam in exams:
            if isinstance(exam, dict) and exam.get('slug') == exam_name:
                exam_data = exam
                break

    # fallback
    if not exam_data:
        exam_data = {
            "name": exam_name.upper(),
            "full_name": "Details coming soon...",
            "category": "General",
            "vacancy_approx": "N/A",
            "salary": "N/A",
            "eligibility": "N/A",
            "syllabus": {},
            "exam_pattern": {},
            "strategy": [],
            "previous_questions": []
        }

    return render_template('exam.html', exam=exam_data)